# ── AI ─────────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── Auth ───────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-64-character-string

# ── Admin ──────────────────────────────────────────────────────────────────
ADMIN_PASSWORD=your_secure_admin_password

# ── Database ───────────────────────────────────────────────────────────────
# SQLite (default — no setup needed)
USE_SQLITE=True

# PostgreSQL (for production)
# USE_SQLITE=False
# DATABASE_URL=postgresql://user:password@localhost:5432/agentix

# ── Storage ─────────────────────────────────────────────────────────────────
# Default paths work for local dev and Docker (where ./data is a mounted volume).
# On Railway/Render/Fly.io set these to a persistent-volume mount point, e.g.:
#   PDF_DIR=/mnt/data/pdfs
#   LOGO_DIR=/mnt/data/logos
#   CHROMA_DIR=/mnt/data/chroma_db
#
# PDF_DIR=./data/pdfs
# LOGO_DIR=./data/logos
# CHROMA_DIR=./data/chroma_db
